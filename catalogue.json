{
  "$schema": "./catalogue.schema.json",
  "schemaVersion": 1,
  "minimumLauncherVersion": "0.0.0",
  "apps": {
    "aws": {
      "kind": "command",
      "image": {
        "repository": "amazon/aws-cli",
        "tag": "2.39.7"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/aws",
          "create": false,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".aws"
          },
          "target": "/tmp/.aws",
          "create": true,
          "readOnly": false
        }
      ],
      "environment": {
        "AWS_CONFIG_FILE": "/tmp/.aws/config",
        "AWS_SHARED_CREDENTIALS_FILE": "/tmp/.aws/credentials"
      }
    },
    "etcd": {
      "kind": "service",
      "image": {
        "repository": "gcr.io/etcd-development/etcd",
        "tag": "v3.7.3"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "etcd",
      "ports": [
        {
          "hostPort": 2379,
          "containerPort": 2379,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        },
        {
          "hostPort": 2380,
          "containerPort": 2380,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ],
      "mounts": [
        {
          "type": "volume",
          "name": "etcd",
          "target": "/etcd-data",
          "readOnly": false
        }
      ],
      "args": [
        "--listen-client-urls",
        "http://0.0.0.0:2379",
        "--advertise-client-urls",
        "http://0.0.0.0:2379"
      ],
      "entrypoint": [
        "/usr/local/bin/etcd"
      ]
    },
    "etcdctl": {
      "kind": "command",
      "image": {
        "repository": "gcr.io/etcd-development/etcd",
        "tag": "v3.7.3"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "entrypoint": [
        "/usr/local/bin/etcdctl"
      ],
      "workdir": "/etcd",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/etcd",
          "create": false,
          "readOnly": false
        }
      ],
      "args": []
    },
    "go": {
      "kind": "command",
      "image": {
        "repository": "golang",
        "tag": "1.24.6-bullseye"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "args": [
        "go"
      ],
      "workdir": "/src",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/src",
          "create": false,
          "readOnly": false
        }
      ]
    },
    "helm": {
      "kind": "command",
      "image": {
        "repository": "alpine/helm",
        "tag": "4.3.1"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "workdir": "/helm",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/helm",
          "create": false,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".kube"
          },
          "target": "/.kube",
          "create": true,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".helm"
          },
          "target": "/.helm",
          "create": true,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".config/helm"
          },
          "target": "/.config/helm",
          "create": true,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".cache/helm"
          },
          "target": "/.cache/helm",
          "create": true,
          "readOnly": false
        }
      ]
    },
    "helmfile": {
      "kind": "command",
      "image": {
        "repository": "ghcr.io/helmfile/helmfile",
        "tag": "canary"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "entrypoint": [
        "/usr/local/bin/helmfile"
      ],
      "workdir": "/helmfile",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/helmfile",
          "create": false,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".kube"
          },
          "target": "/.kube",
          "create": true,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".helm"
          },
          "target": "/.helm",
          "create": true,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".config/helm"
          },
          "target": "/.config/helm",
          "create": true,
          "readOnly": false
        },
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".cache/helm"
          },
          "target": "/.cache/helm",
          "create": true,
          "readOnly": false
        }
      ],
      "args": []
    },
    "kubectl": {
      "kind": "command",
      "image": {
        "repository": "alpine/kubectl",
        "tag": "1.37.2"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "home",
            "path": ".kube"
          },
          "target": "/.kube",
          "create": true,
          "readOnly": false
        }
      ],
      "environment": {
        "KUBECONFIG": "/.kube/config"
      }
    },
    "mariadb-server": {
      "kind": "service",
      "image": {
        "repository": "mariadb",
        "tag": "11.3.2-jammy"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "mariadb",
      "ports": [
        {
          "hostPort": 3306,
          "containerPort": 3306,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ],
      "mounts": [
        {
          "type": "volume",
          "name": "mariadb",
          "target": "/var/lib/mysql",
          "readOnly": false
        }
      ],
      "environment": {
        "MARIADB_ROOT_PASSWORD": "root"
      }
    },
    "memcached": {
      "kind": "service",
      "image": {
        "repository": "memcached",
        "tag": "1.6.17-alpine3.16"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "memcached",
      "ports": [
        {
          "hostPort": 11211,
          "containerPort": 11211,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ]
    },
    "mysql": {
      "kind": "command",
      "image": {
        "repository": "mysql",
        "tag": "8.0.46"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "args": [
        "mysql"
      ],
      "workdir": "/mysql",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/mysql",
          "create": false,
          "readOnly": false
        }
      ]
    },
    "mysql-server": {
      "kind": "service",
      "image": {
        "repository": "mysql",
        "tag": "8.0.46"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "mysql",
      "ports": [
        {
          "hostPort": 3306,
          "containerPort": 3306,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ],
      "mounts": [
        {
          "type": "volume",
          "name": "mysql",
          "target": "/var/lib/mysql",
          "readOnly": false
        }
      ],
      "environment": {
        "MYSQL_ROOT_PASSWORD": "root"
      }
    },
    "mysqldump": {
      "kind": "command",
      "image": {
        "repository": "mysql",
        "tag": "8.0.46"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "args": [
        "mysqldump"
      ],
      "workdir": "/mysql",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/mysql",
          "create": false,
          "readOnly": false
        }
      ]
    },
    "nats": {
      "kind": "command",
      "image": {
        "repository": "natsio/nats-box",
        "tag": "0.20.2"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "entrypoint": [
        "/usr/local/bin/nats"
      ],
      "workdir": "/nats",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/nats",
          "create": false,
          "readOnly": false
        }
      ],
      "args": []
    },
    "nats-server": {
      "kind": "service",
      "image": {
        "repository": "nats",
        "tag": "2.9.8-alpine3.16"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "nats-server",
      "ports": [
        {
          "hostPort": 4222,
          "containerPort": 4222,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        },
        {
          "hostPort": 6222,
          "containerPort": 6222,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        },
        {
          "hostPort": 8222,
          "containerPort": 8222,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ]
    },
    "pg_dump": {
      "kind": "command",
      "image": {
        "repository": "postgres",
        "tag": "15.1-alpine3.16"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "args": [
        "pg_dump"
      ],
      "workdir": "/postgres",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/postgres",
          "create": false,
          "readOnly": false
        }
      ]
    },
    "pgadmin4": {
      "kind": "service",
      "image": {
        "repository": "dpage/pgadmin4",
        "tag": "9.19"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "pgadmin4",
      "ports": [
        {
          "hostPort": 8080,
          "containerPort": 80,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ],
      "mounts": [
        {
          "type": "volume",
          "name": "pgadmin4",
          "target": "/var/lib/pgadmin",
          "readOnly": false
        }
      ],
      "environment": {
        "PGADMIN_DEFAULT_EMAIL": "user@pgadmin.org",
        "PGADMIN_DEFAULT_PASSWORD": "pgadmin"
      }
    },
    "phpmyadmin": {
      "kind": "service",
      "image": {
        "repository": "phpmyadmin",
        "tag": "5.2.3-apache"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "phpmyadmin",
      "ports": [
        {
          "hostPort": 8082,
          "containerPort": 80,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ],
      "environment": {
        "PMA_ARBITRARY": "1"
      }
    },
    "postgres": {
      "kind": "service",
      "image": {
        "repository": "postgres",
        "tag": "15.1-alpine3.16"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "postgres",
      "ports": [
        {
          "hostPort": 5432,
          "containerPort": 5432,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ],
      "mounts": [
        {
          "type": "volume",
          "name": "postgres",
          "target": "/var/lib/postgresql/data",
          "readOnly": false
        }
      ],
      "environment": {
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "postgres"
      }
    },
    "psql": {
      "kind": "command",
      "image": {
        "repository": "postgres",
        "tag": "15.1-alpine3.16"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "args": [
        "psql"
      ],
      "workdir": "/postgres",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/postgres",
          "create": false,
          "readOnly": false
        }
      ]
    },
    "redis": {
      "kind": "service",
      "image": {
        "repository": "redis",
        "tag": "7.0.5-alpine3.16"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "redis",
      "ports": [
        {
          "hostPort": 6379,
          "containerPort": 6379,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ],
      "mounts": [
        {
          "type": "volume",
          "name": "redis",
          "target": "/data",
          "readOnly": false
        }
      ],
      "args": [
        "--save",
        "60",
        "1"
      ]
    },
    "redis-cli": {
      "kind": "command",
      "image": {
        "repository": "redis",
        "tag": "7.0.5-alpine3.16"
      },
      "network": "host",
      "user": {
        "linux": "host",
        "windows": "image",
        "darwin": "host"
      },
      "args": [
        "redis-cli"
      ],
      "workdir": "/redis",
      "mounts": [
        {
          "type": "bind",
          "source": {
            "base": "cwd",
            "path": ""
          },
          "target": "/redis",
          "create": false,
          "readOnly": false
        }
      ]
    },
    "redis-stack": {
      "kind": "service",
      "image": {
        "repository": "redis/redis-stack",
        "tag": "7.4.0-v3"
      },
      "network": "bridge",
      "user": {
        "linux": "image",
        "windows": "image",
        "darwin": "image"
      },
      "containerName": "redis-stack",
      "ports": [
        {
          "hostPort": 6379,
          "containerPort": 6379,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        },
        {
          "hostPort": 8083,
          "containerPort": 8001,
          "protocol": "tcp",
          "hostIP": "0.0.0.0"
        }
      ],
      "mounts": [
        {
          "type": "volume",
          "name": "redis-stack",
          "target": "/data",
          "readOnly": false
        }
      ]
    }
  }
}
