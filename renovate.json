{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":disableDependencyDashboard"
  ],
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "jsonata",
      "managerFilePatterns": [
        "/^catalogue\\.json$/"
      ],
      "matchStrings": [
        "apps.*.image.{\"depName\": repository, \"currentValue\": tag, \"currentDigest\": digest}"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "fileFormat": "json"
    }
  ]
}
