{
  "kind": "service",
  "image": {
    "repository": "dpage/pgadmin4",
    "tag": "9.19"
  },
  "network": "bridge",
  "user": {
    "linux": "image",
    "windows": "image",
    "darwin": "image"
  },
  "containerName": "pgadmin4",
  "ports": [
    {
      "hostPort": 8080,
      "containerPort": 80,
      "protocol": "tcp",
      "hostIP": "0.0.0.0"
    }
  ],
  "mounts": [
    {
      "type": "volume",
      "name": "pgadmin4",
      "target": "/var/lib/pgadmin",
      "readOnly": false
    }
  ],
  "environment": {
    "PGADMIN_DEFAULT_EMAIL": "user@pgadmin.org",
    "PGADMIN_DEFAULT_PASSWORD": "pgadmin"
  }
}
