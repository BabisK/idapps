{
  "kind": "service",
  "image": {
    "repository": "gcr.io/etcd-development/etcd",
    "tag": "v3.7.3"
  },
  "network": "bridge",
  "user": {
    "linux": "image",
    "windows": "image",
    "darwin": "image"
  },
  "containerName": "etcd",
  "ports": [
    {
      "hostPort": 2379,
      "containerPort": 2379,
      "protocol": "tcp",
      "hostIP": "0.0.0.0"
    },
    {
      "hostPort": 2380,
      "containerPort": 2380,
      "protocol": "tcp",
      "hostIP": "0.0.0.0"
    }
  ],
  "mounts": [
    {
      "type": "volume",
      "name": "etcd",
      "target": "/etcd-data",
      "readOnly": false
    }
  ],
  "args": [
    "--listen-client-urls",
    "http://0.0.0.0:2379",
    "--advertise-client-urls",
    "http://0.0.0.0:2379"
  ],
  "entrypoint": [
    "/usr/local/bin/etcd"
  ]
}
