{
  "kind": "service",
  "image": {
    "repository": "nats",
    "tag": "2.9.8-alpine3.16"
  },
  "network": "bridge",
  "user": {
    "linux": "image",
    "windows": "image",
    "darwin": "image"
  },
  "containerName": "nats-server",
  "ports": [
    {
      "hostPort": 4222,
