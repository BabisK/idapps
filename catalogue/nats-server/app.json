    },
    {
      "hostPort": 6222,
      "containerPort": 6222,
      "protocol": "tcp",
      "hostIP": "0.0.0.0"
    },
    {
      "hostPort": 8222,
      "containerPort": 8222,
      "protocol": "tcp",
      "hostIP": "0.0.0.0"
    }
  ]
}
