{
  "kind": "service",
  "image": {
    "repository": "postgres",
    "tag": "15.1-alpine3.16"
  },
  "network": "bridge",
  "user": {
    "linux": "image",
    "windows": "image",
    "darwin": "image"
  },
  "containerName": "postgres",
  "ports": [
    {
      "hostPort": 5432,
      "containerPort": 5432,
      "protocol": "tcp",
      "hostIP": "0.0.0.0"
    }
  ],
  "mounts": [
    {
      "type": "volume",
      "name": "postgres",
      "target": "/var/lib/postgresql/data",
      "readOnly": false
    }
  ],
  "environment": {
    "POSTGRES_USER": "postgres",
    "POSTGRES_PASSWORD": "postgres"
  }
}
